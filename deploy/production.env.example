APP_NAME=Marked
APP_ENV=production
APP_URL=https://your-domain.no
SESSION_SECURE=1
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=replace-with-your-database-password
# DB_SSL_CA=/absolute/private/path/provider-ca.pem
MAIL_TRANSPORT=mail
MAIL_FROM=hei@your-domain.no
# For authenticated SMTP, use MAIL_TRANSPORT=smtp and your provider's settings:
# MAIL_HOST=your-smtp-host
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=hei@your-domain.no
# MAIL_PASSWORD=replace-with-your-mail-password
